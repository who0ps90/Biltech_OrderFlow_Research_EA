; Experimental genuine-volume profile plus proxy price evidence. Requires imported data and full UTC coverage. No tick-volume substitute.
; Guarded: clock acknowledgment is false, live trading is false. Fees must be configured per contract.
InpDataMode=0
InpAllowLiveTrading=false
InpConfigId=experimental-proxy-genuine-profile-v1
InpRunId=profile-development-run
InpMagic=5102504
InpBrokerClockAcknowledged=false
InpBrokerOffsetSchedule=broker_offsets.csv
InpPivotSide=2
InpExpiryBars=12
InpConfirmationBars=3
InpH1Lookback=512
InpForceFlatAtSessionEnd=true
InpRiskPercent=0.25
InpMaxSessionEntries=2
InpMaxConsecutiveSessionLosses=2
InpMaxSessionDrawdownPercent=0.50
InpStopMinimumTicks=2.0
InpStopMaximumTicks=1000.0
InpMaximumSpreadTicks=0.0
InpEstimatedCommissionPerLotRoundTurn=0.0
InpEstimatedSlippageTicksPerSide=1.0
InpDeviationPoints=20
InpTargetMode=0
InpFixedR=1.5
InpMinimumNetRR=1.5
InpUseProfile=true
InpExchangeManifest=exchange_manifest.csv
InpExchangeCells=exchange_cells.csv
InpDataCoverageFromUtc=
InpDataCoverageToUtc=
InpProfileBinTicks=1.0
InpImbalanceRatio=4.0
InpMinimumCellVolume=1.0
InpMaximumUnknownFraction=0.0
InpEnableMNQMinimumVolume=false
InpMNQMinimumBarContracts=20000.0
InpExportCSV=true
InpChartVisuals=false

